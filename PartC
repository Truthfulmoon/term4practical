private Socket socket;
private ObjectOutputStream out;
private ObjectInputStream in;

public void connect() throws IOException {             // C1
    socket = new Socket(host, port);
    out = new ObjectOutputStream(socket.getOutputStream());
    out.flush();
    in = new ObjectInputStream(socket.getInputStream());
}

public String addTicket(ParkingTicket ticket) throws IOException, ClassNotFoundException {   // C2
    out.writeObject(Protocol.ADD);
    out.writeObject(ticket);
    out.flush();
    return (String) in.readObject();
}

@SuppressWarnings("unchecked")
public List<ParkingTicket> retrieveTickets() throws IOException, ClassNotFoundException {    // C3
    out.writeObject(Protocol.RETRIEVE);
    out.flush();
    return (List<ParkingTicket>) in.readObject();
}

public void disconnect() {                             // C4
    try {
        if (out != null) {
            out.writeObject(Protocol.EXIT);
            out.flush();
            out.close();
        }
        if (in != null) in.close();
        if (socket != null) socket.close();
    } catch (IOException ex) {
        System.out.println("Error while disconnecting: " + ex.getMessage());
    }
}
